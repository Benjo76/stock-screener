# ==============================================================================
# Stock Screener & Portfolio Research Agent - Environment Configuration Example
# ==============================================================================

# Application Environment (production, development, test)
APP_ENV=development

# Database Settings (PostgreSQL)
POSTGRES_DB=
POSTGRES_USER
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=

# Database Connection URL (Optional override, generated automatically from above if not set)
# DATABASE_URL=postgresql+psycopg://stockagent:change_this_to_a_secure_password_in_production@localhost:5432/stockagent

# API Security
# X-API-KEY header required for protected endpoints
API_KEY=

# Financial Data Provider (auto, yahoo, mock)
FINANCIAL_DATA_PROVIDER=auto

# Upload Size Limits (Bytes) - default: 10 MB
MAX_UPLOAD_SIZE_BYTES=10485760
